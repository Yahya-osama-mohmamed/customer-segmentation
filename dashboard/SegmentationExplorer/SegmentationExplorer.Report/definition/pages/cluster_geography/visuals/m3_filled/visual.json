{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "m3_filled",
  "position": {
    "x": 24,
    "y": 228,
    "z": 0,
    "width": 480,
    "height": 240
  },
  "visual": {
    "visualType": "filledMap",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCountry"
                    }
                  },
                  "Property": "Country"
                }
              },
              "queryRef": "DimCountry.Country",
              "nativeQueryRef": "Country"
            }
          ]
        },
        "Gradient": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Customers"
                    }
                  },
                  "Property": "Lifetime Revenue"
                }
              },
              "queryRef": "Customers.Lifetime Revenue",
              "nativeQueryRef": "Lifetime Revenue"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Lifetime revenue by country — deeper colour = more revenue'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    }
  }
}